# Copy this file to secrets.yaml (same folder) and fill in real values.
# secrets.yaml is gitignored -- never commit it.

wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"
fallback_ap_password: "choose-a-fallback-password"

# Generate with:
#   python3 -c "import random,base64; print(base64.b64encode(bytes(random.getrandbits(8) for _ in range(32))).decode())"
api_encryption_key: "generate-a-32-byte-base64-key"

ota_password: "choose-an-ota-password"
